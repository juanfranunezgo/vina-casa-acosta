# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# fotos originales sin optimizar (solo public/images/ se versiona)
/_fotos-input

# hosting (estado local de la CLI)
.netlify
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# escrituras a medio hacer del snapshot (escribirAtomico las limpia sola;
# esto es por si el proceso muere justo entre el write y el rename)
data/*.tmp

# copias de trabajo de los agentes (.claude/worktrees son repos enteros: 617 MB
# el dia que se midio). launch.json NO se ignora: es configuracion de verdad.
/.claude/worktrees

# respaldos, temporales y candado del refresco del snapshot: viven lo que dura
# una corrida (ver el protocolo del par en scripts/catalogo-integridad.mjs) y si
# alguno sobrevive es porque hubo una muerte, no algo para commitear
/data/*.bak
/data/*.tmp
/data/*.lock
