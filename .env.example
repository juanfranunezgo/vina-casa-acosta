# Variables de entorno del sitio. Copiar a `.env.local` para desarrollo y
# definirlas en Netlify → Project configuration → Environment variables.

# Dominio público del sitio. Se usa para `metadataBase` (canonical + Open Graph)
# y para las URLs absolutas del JSON-LD.
#
# En Netlify NO hace falta definirla mientras se use el subdominio
# `*.netlify.app`: el build ya recibe `URL` y `lib/siteUrl.ts` la toma de ahí.
# Definirla recién cuando el sitio tenga dominio propio.
#
# NEXT_PUBLIC_SITE_URL=https://casaacosta.cl

# --- Catálogo servido por Afeleia ---------------------------------------------
# Las dos únicas variables que la web necesita para leer el catálogo. Ninguna es
# secreta: la API pública es de solo lectura y no lleva credenciales. Si falta
# cualquiera de las dos, la web sirve `data/catalogo-fallback.json` y lo registra
# en el log del servidor — no se le muestra ningún error al visitante.

# Base de las Edge Functions de Afeleia (sin barra final).
#   local: http://127.0.0.1:54321/functions/v1
# NEXT_PUBLIC_AFELEIA_API_URL=https://<project-ref>.supabase.co/functions/v1

# Slug público del sitio en Afeleia.
# NEXT_PUBLIC_AFELEIA_SITIO=afeleia-demo
